# Aggregator address for packed .ehpk builds.
#
# The packed app runs from a local bundle in the Even App WebView, so it
# cannot infer where the Mac is -- this must point at a host the phone can
# reach. Tailscale IP is used so it works off the home LAN too.
#
# Check the current value with: tailscale ip -4
VITE_WS_URL=ws://100.100.184.64:9500
